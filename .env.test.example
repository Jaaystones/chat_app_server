# Environment
NODE_ENV=test
PORT=4001

# Dedicated test database — kept separate from dev so test runs never touch dev data
DATABASE_URL=postgresql://linguabridge:linguabridge@localhost:5432/linguabridge_test?schema=public

# Separate Redis logical DB (index 1) to keep test cache/denylist keys isolated from dev
REDIS_URL=redis://localhost:6379/1

JWT_ACCESS_SECRET=test-access-secret-must-be-at-least-32-chars-long
JWT_REFRESH_SECRET=test-refresh-secret-must-be-at-least-32-chars-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

CORS_ORIGIN=http://localhost:3000

# mock keeps the bulk of the suite hermetic/fast; the dedicated LibreTranslate
# integration test constructs its own provider instance against LIBRETRANSLATE_URL
# regardless of this setting, so real-service coverage doesn't require it here.
TRANSLATION_PROVIDER=mock
LIBRETRANSLATE_URL=http://localhost:5000
DEEPL_API_KEY=
GOOGLE_TRANSLATE_API_KEY=
