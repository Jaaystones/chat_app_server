generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Source of truth for which languages the app offers and whether the
// active translation provider actually supports them. Never hardcode
// languages elsewhere (Rule 4 / Section 26).
model Language {
  id                   String  @id @default(uuid())
  code                 String  @unique // BCP-47-ish short code, e.g. "en", "fr", "yo"
  name                 String
  nativeName           String
  isActive             Boolean @default(true)
  translationSupported Boolean @default(false)
  voiceSupported       Boolean @default(false)

  createdAt DateTime @default(now())

  users User[]

  @@map("languages")
}

enum UserStatus {
  ONLINE
  OFFLINE
}

model User {
  id                    String     @id @default(uuid())
  firstName             String     @map("first_name")
  lastName              String     @map("last_name")
  username              String     @unique
  email                 String     @unique
  passwordHash          String     @map("password_hash")
  preferredLanguageCode String     @map("preferred_language")
  preferredLanguage     Language   @relation(fields: [preferredLanguageCode], references: [code])
  country                String?
  avatarUrl              String?   @map("avatar_url")
  status                 UserStatus @default(OFFLINE)
  autoTranslate           Boolean  @default(true) @map("auto_translate")
  showOriginalByDefault   Boolean  @default(false) @map("show_original_by_default")
  lastSeen                DateTime? @map("last_seen")
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  participants ConversationParticipant[]
  messages     Message[]

  @@index([preferredLanguageCode])
  @@map("users")
}

enum ConversationType {
  DIRECT
  GROUP
  BUSINESS
}

model Conversation {
  id        String            @id @default(uuid())
  type      ConversationType  @default(DIRECT)
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")

  participants ConversationParticipant[]
  messages     Message[]

  @@map("conversations")
}

model ConversationParticipant {
  id                 String   @id @default(uuid())
  conversationId     String   @map("conversation_id")
  conversation       Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId             String   @map("user_id")
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt           DateTime @default(now()) @map("joined_at")
  lastReadMessageId  String?  @map("last_read_message_id")

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("conversation_participants")
}

enum MessageType {
  TEXT
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
}

model Message {
  id               String        @id @default(uuid())
  conversationId   String        @map("conversation_id")
  conversation     Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId         String        @map("sender_id")
  sender           User          @relation(fields: [senderId], references: [id])
  originalContent  String        @map("original_content")
  detectedLanguage String?       @map("detected_language")
  messageType      MessageType   @default(TEXT) @map("message_type")
  status           MessageStatus @default(SENT)
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")
  editedAt         DateTime?     @map("edited_at")
  deletedAt        DateTime?     @map("deleted_at")

  translations MessageTranslation[]

  @@index([conversationId, createdAt])
  @@map("messages")
}

enum TranslationStatus {
  PENDING
  COMPLETED
  FAILED
  SKIPPED
}

model MessageTranslation {
  id                String             @id @default(uuid())
  messageId         String             @map("message_id")
  message           Message            @relation(fields: [messageId], references: [id], onDelete: Cascade)
  targetLanguage    String             @map("target_language")
  translatedContent String?            @map("translated_content")
  provider          String
  status            TranslationStatus  @default(PENDING)
  errorMessage      String?            @map("error_message")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  @@unique([messageId, targetLanguage])
  @@map("message_translations")
}
