# Environment
NODE_ENV=development
PORT=4000

# PostgreSQL (matches docker-compose.yml service defaults)
DATABASE_URL=postgresql://linguabridge:linguabridge@localhost:5432/linguabridge?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# JWT — generate with `openssl rand -base64 48`. Never commit real values.
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-chars
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-at-least-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# CORS
CORS_ORIGIN=http://localhost:3000

# Translation provider: libretranslate | deepl | google | mock
# libretranslate = self-hosted, free, no API key (see docker-compose.yml `translate` service)
# mock = no external dependency at all; deterministic stand-in for offline dev
TRANSLATION_PROVIDER=libretranslate
LIBRETRANSLATE_URL=http://localhost:5000
DEEPL_API_KEY=
GOOGLE_TRANSLATE_API_KEY=
